# Copy to .env.local. Every variable is optional for local development.

# ---- Your deployment ---------------------------------------------------------
# Public URL of this copy: canonical links, sitemap, robots.txt and social
# cards use it. Defaults to https://resumecanvas.site (the upstream project).
NEXT_PUBLIC_SITE_URL=
# Where its source lives: GitHub links across the site. Defaults to
# https://github.com/kstmostofa/resume-canvas.
NEXT_PUBLIC_REPO_URL=

# ---- Share links -------------------------------------------------------------
# Any Upstash-compatible Redis REST endpoint. Unset, development falls back to
# an in-process store; a production build refuses to create links without it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- AI import, quick add and suggestions ------------------------------------
# Unset, the AI buttons don't appear. Set a credit limit on the key as a
# backstop; requests are also rate limited per address.
OPENROUTER_API_KEY=
# Any OpenRouter model that supports structured outputs.
OPENROUTER_MODEL=
# Any other OpenAI-compatible endpoint instead of OpenRouter.
OPENROUTER_BASE_URL=
